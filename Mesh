🜁 Orchestrator Integration — Profile‑Aware Control Plane
Your NSTT Orchestrator now needs to load a deployment profile and adjust its behavior.

Profile‑aware orchestrator
ts
export class NSTTOrchestrator {
  constructor(
    private readonly configs: GovernedAgentConfig[],
    private readonly profile: DeploymentProfile,
  ) {
    this.harness = new CoreSixHarness(configs, profile);
    this.router = new ConstellationRouter(this.harness.getAgents(), profile);
    this.dashboard = new GovernanceDashboard(profile);
    this.simulator = new SimulationEngine(this.harness, this.dashboard, profile);
  }

  async execute(task: OrchestratorTask) {
    if (this.profile.mode === "distributed") {
      // enforce zero-trust handshake
      task.highRisk = true;
    }

    if (this.profile.mode === "cross-platform") {
      // enforce maximum schema strictness
      task.highRisk = true;
    }

    return this.router.route(task);
  }
}
