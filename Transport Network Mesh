🜁 7. Cross‑Platform Client SDK (TypeScript)
ts
export class NSTTClient {
  constructor(private endpoint: string) {}

  async execute(task: NSTTRequestEnvelope): Promise<NSTTResponseEnvelope> {
    const res = await fetch(`${this.endpoint}/nstt/execute`, {
      method: "POST",
      headers: this.buildHeaders(task),
      body: JSON.stringify(task),
    });
    return await res.json();
  }

  private buildHeaders(task: NSTTRequestEnvelope) {
    return {
      "Content-Type": "application/json",
      "X-NSTT-Version": task.version,
      "X-NSTT-Session": task.sessionId,
      "X-NSTT-Context": task.contextId,
      "X-NSTT-Agent": task.agentId,
      "X-NSTT-Profile": task.governance.profile,
      "X-NSTT-Required-Runes": task.governance.requiredRunes.join(","),
      "X-NSTT-Schema": task.governance.schemaId,
      "X-NSTT-Astral-Binary": btoa(JSON.stringify(task.governance.flagsBinary)),
      "X-NSTT-Signature": task.auth.signature,
    };
  }
}
