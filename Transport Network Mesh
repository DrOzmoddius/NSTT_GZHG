3. Mesh registry
ts
export class MeshRegistry {
  private nodes = new Map<string, MeshBeacon>();

  register(beacon: MeshBeacon) {
    this.nodes.set(beacon.nodeId, beacon);
  }

  getAgentsByRole(role: string) {
    const result: { nodeId: string; agentId: string }[] = [];
    this.nodes.forEach(b => {
      b.agents
        .filter(a => a.role === role)
        .forEach(a => result.push({ nodeId: b.nodeId, agentId: a.agentId }));
    });
    return result;
  }

  getAll() {
    return Array.from(this.nodes.values());
  }
}
4. Mesh‑aware router
Your ConstellationRouter now asks the registry where to send a task:

ts
export class MeshRouter {
  constructor(
    private readonly registry: MeshRegistry,
    private readonly clientFactory: (nodeId: string) => NSTTClient,
  ) {}

  async route(task: RouteTask): Promise<RouteResult> {
    const role = this.roleFor(task.kind);
    const candidates = this.registry.getAgentsByRole(role);
    if (candidates.length === 0) {
      throw new Error(`No mesh agents available for role: ${role}`);
    }

    const target = candidates[0]; // simple strategy; can be load‑balanced
    const client = this.clientFactory(target.nodeId);

    const envelope: NSTTRequestEnvelope = {
      version: "NSTT-1.0",
      sessionId: task.sessionId,
      contextId: task.contextId ?? `${task.sessionId}-${task.kind}`,
      agentId: target.agentId,
      task: {
        kind: task.kind,
        input: task.input,
        intentId: "mesh-task",
        intentHash: `hash(intent:mesh-task:${task.kind})`,
        highRisk: task.highRisk ?? true,
      },
      governance: {
        mode: "cross-platform",
        profile: "mesh",
        requiredRunes: [], // filled per role
        schemaId: "NSTT-GOV-CORE-001",
        schemaVersion: "1.0.0",
        flagsBinary: buildFlagsBinary(true, task.highRisk ?? true, true),
      },
      auth: {
        principalId: "mesh-orchestrator",
        token: "mesh-token",
        signature: "sig(mesh-request)",
      },
    };

    const response = await client.execute(envelope);
    return { agentId: target.agentId, response };
  }

  private roleFor(kind: TaskKind): string {
    switch (kind) {
      case "reason": return "primary";
      case "audit": return "auditor";
      case "oracle": return "oracle";
      case "security": return "security";
      case "archive": return "archive";
      case "fabricate": return "fabricator";
    }
  }
}
