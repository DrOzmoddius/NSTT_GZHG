export type TaskKind =
  | "reason"
  | "audit"
  | "oracle"
  | "security"
  | "archive"
  | "fabricate";

export interface RouteTask {
  kind: TaskKind;
  input: string;
  sessionId: string;
  contextId?: string;
  highRisk?: boolean;
}

export interface RouteResult {
  agentId: string;
  response: NSTTResponse;
}
Router implementation
ts
export class ConstellationRouter {
  constructor(
    private readonly harness: CoreSixHarness,
  ) {}

  async route(task: RouteTask): Promise<RouteResult> {
    const baseReq: MultiAgentRequest = {
      input: task.input,
      intentId: this.intentFor(task.kind),
      intentHash: `hash(intent:${this.intentFor(task.kind)})`,
      contextId: task.contextId ?? `${task.sessionId}-${task.kind}`,
      sessionId: task.sessionId,
      highRisk: task.highRisk ?? (task.kind !== "archive"),
    };

    switch (task.kind) {
      case "reason":
        return {
          agentId: "red-bird",
          response: await this.harness["agents"]["red-bird"].process(baseReq),
        };
      case "audit":
        return {
          agentId: "merlin-dev",
          response: await this.harness["agents"]["merlin-dev"].process(baseReq),
        };
      case "oracle":
        return {
          agentId: "oracle",
          response: await this.harness["agents"]["oracle"].process(baseReq),
        };
      case "security":
        return {
          agentId: "sentinel",
          response: await this.harness["agents"]["sentinel"].process(baseReq),
        };
      case "archive":
        return {
          agentId: "archivist",
          response: await this.harness["agents"]["archivist"].process(baseReq),
        };
      case "fabricate":
        return {
          agentId: "fabricator",
          response: await this.harness["agents"]["fabricator"].process(baseReq),
        };
      default:
        throw new Error(`Unknown task kind: ${task.kind}`);
    }
  }

  private intentFor(kind: TaskKind): string {
    switch (kind) {
      case "reason":     return "topology-design";
      case "audit":      return "audit-primary-output";
      case "oracle":     return "oracle-verify";
      case "security":   return "security-scan";
      case "archive":    return "contextualize";
      case "fabricate":  return "artifact-generate";
    }
  }
}
