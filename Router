export interface RuneTraceEntry {
  agentId: string;
  sessionId: string;
  contextId: string;
  rune: string;          // RuneId
  name: string;          // opcode name
  args: Record<string, unknown>;
  chainIndex: number;
  timestamp: number;
}

export interface ViolationEntry {
  agentId: string;
  sessionId: string;
  contextId: string;
  code: string;
  details: string;
  timestamp: number;
}

export interface GovernanceSnapshot {
  sessionId: string;
  primaryAgentId: string;
  consensusValid: boolean;
  runeTrace: RuneTraceEntry[];
  violations: ViolationEntry[];
}
Dashboard collector
ts
export class GovernanceDashboard {
  private runeTrace: RuneTraceEntry[] = [];
  private violations: ViolationEntry[] = [];

  recordRune(
    agentId: string,
    sessionId: string,
    contextId: string,
    opcode: RuneOpcode,
    chainIndex: number,
  ) {
    this.runeTrace.push({
      agentId,
      sessionId,
      contextId,
      rune: opcode.rune,
      name: opcode.name,
      args: opcode.args,
      chainIndex,
      timestamp: Date.now(),
    });
  }

  recordViolation(
    agentId: string,
    sessionId: string,
    contextId: string,
    code: string,
    details: string,
  ) {
    this.violations.push({
      agentId,
      sessionId,
      contextId,
      code,
      details,
      timestamp: Date.now(),
    });
  }

  snapshot(sessionId: string, primaryAgentId: string, consensusValid: boolean): GovernanceSnapshot {
    return {
      sessionId,
      primaryAgentId,
      consensusValid,
      runeTrace: this.runeTrace.filter(r => r.sessionId === sessionId),
      violations: this.violations.filter(v => v.sessionId === sessionId),
    };
  }
}
